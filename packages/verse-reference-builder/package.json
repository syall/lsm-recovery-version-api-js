{
  "name": "@syall/verse-reference-builder",
  "version": "0.3.0",
  "description": "Type-safe, dependency-free builder for LSM Text Only Holy Bible Recovery Version API verse-reference strings.",
  "keywords": [
    "lsm",
    "recovery-version",
    "bible",
    "typescript",
    "verse-reference",
    "builder"
  ],
  "license": "MIT",
  "author": "Steven Yuan (syall)",
  "homepage": "https://github.com/syall/lsm-recovery-version-api-js/tree/main/packages/verse-reference-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syall/lsm-recovery-version-api-js.git",
    "directory": "packages/verse-reference-builder"
  },
  "bugs": {
    "url": "https://github.com/syall/lsm-recovery-version-api-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "umdName": "VerseReferenceBuilder",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "unpkg": "./dist/umd/verse-reference-builder.min.js",
  "jsdelivr": "./dist/umd/verse-reference-builder.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist dist-test",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:umd": "node ../../scripts/build-umd.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:umd && node ../../scripts/write-dist-manifests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir dist-test && npm run dist-test",
    "dist-test": "node --test \"dist-test/test/builder.test.js\"",
    "test:browser": "npm run build:umd && node ../../scripts/test-browser.mjs",
    "test:runtime:bun": "npm run build:esm && bun ../../scripts/smoke-test-esm.mjs",
    "test:runtime:deno": "npm run build:esm && deno run --allow-read=. ../../scripts/smoke-test-esm.mjs",
    "pretest": "npm run typecheck",
    "prepublishOnly": "npm run test && npm run build",
    "prepare": "npm run build"
  }
}
